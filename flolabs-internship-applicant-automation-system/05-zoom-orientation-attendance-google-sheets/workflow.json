    {
      "parameters": {
        "jsCode": "const participants = $json.participants || [];\n\nconst grouped = {};\n\nfor (const p of participants) {\n  // مفتاح التجميع. الأفضل نبدأ بالإيميل، وإذا ما فيه نستخدم user_id، وإذا ما فيه نستخدم الاسم\n  const key =\n    (p.user_email && p.user_email.trim().toLowerCase()) ||\n    (p.user_id && String(p.user_id).trim()) ||\n    (p.name && p.name.trim().toLowerCase()) ||\n    `unknown_${Math.random()}`;\n\n  if (!grouped[key]) {\n    grouped[key] = {\n      user_id: p.user_id || null,\n      name: p.name || null,\n      email: p.user_email || null,\n      first_join_time: p.join_time || null,\n      last_leave_time: p.leave_time || null,\n      duration: Number(p.duration || 0),\n      sessions_count: 1\n    };\n  } else {\n    // جمع المدة\n    grouped[key].duration += Number(p.duration || 0);\n\n    // تحديث أول وقت دخول\n    if (\n      p.join_time &&\n      (!grouped[key].first_join_time || new Date(p.join_time) < new Date(grouped[key].first_join_time))\n    ) {\n      grouped[key].first_join_time = p.join_time;\n    }\n\n    // تحديث آخر وقت خروج\n    if (\n      p.leave_time &&\n      (!grouped[key].last_leave_time || new Date(p.leave_time) > new Date(grouped[key].last_leave_time))\n    ) {\n      grouped[key].last_leave_time = p.leave_time;\n    }\n\n    // عداد عدد الجلسات\n    grouped[key].sessions_count += 1;\n\n    // لو كان الحقل ناقص بالسجل الأول، نعبيه من السجلات التالية\n    if (!grouped[key].user_id && p.user_id) grouped[key].user_id = p.user_id;\n    if (!grouped[key].name && p.name) grouped[key].name = p.name;\n    if (!grouped[key].email && p.user_email) grouped[key].email = p.user_email;\n  }\n}\n\nreturn Object.values(grouped).map((p, index) => ({\n  json: {\n    id: index + 1,\n    user_id: p.user_id,\n    name: p.name,\n    email: p.email,\n    first_join_time: p.first_join_time,\n    last_leave_time: p.last_leave_time,\n    duration: p.duration,\n    sessions_count: p.sessions_count\n  }\n}));"
      },
