    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nif (!items.length) {\n  return [];\n}\n\nconst sectionDate = items[0].sectionDate;\n\nconst rows = [\n  // سطر فاضي بالبداية\n  {\n    json: {\n      Applicant: '',\n      Comments: '',\n      Status: '',\n      'Call follow up': '',\n      FU: '',\n      'Follow up status': '',\n      row_type: 'blank_row'\n    }\n  },\n\n  // سطر التاريخ\n  {\n    json: {\n      Applicant: sectionDate,\n      Comments: '',\n      Status: '',\n      'Call follow up': '',\n      FU: '',\n      'Follow up status': '',\n      row_type: 'date_header'\n    }\n  }\n];\n\nfor (const item of items) {\n  rows.push({\n    json: {\n      Applicant: item.name || '',\n      Comments: item.comments || '',\n      Status: item.status || '',\n      'Call follow up': item.call_follow_up || '',\n      FU: '',\n      'Follow up status': '',\n      row_type: 'applicant'\n    }\n  });\n}\n\nreturn rows;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
        880
      ],
      "id": "0bc0e4b5-a430-45f5-98c5-bfe639d6f30b",
      "name": "Build Rows For Applicants Sheet"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction formatOrdinal(day) {\n  if (day >= 11 && day <= 13) return `${day}th`;\n  const last = day % 10;\n  if (last === 1) return `${day}st`;\n  if (last === 2) return `${day}nd`;\n  if (last === 3) return `${day}rd`;\n  return `${day}th`;\n}\n\nconst meetingDate = new Date($node[\"Prepare Meeting Data\"].json.body.payload.object.start_time);\n\nconst month = meetingDate.toLocaleString('en-US', {\n  month: 'long',\n  timeZone: 'UTC'\n});\nconst day = formatOrdinal(meetingDate.getUTCDate());\nconst year = meetingDate.getUTCFullYear();\n\nconst sectionDate = `${month} ${day}, ${year}`;\n\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    sectionDate\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -752,
        880
      ],
      "id": "d8bf2104-fc85-4ed7-a9b3-23c2c328e05b",
      "name": "Format Meeting Date For Sheet"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nif (!items.length) return [];\n\nconst JOHN_EMAIL = 'john@example.com';\nconst OLIVER_EMAIL = 'oliver@example.com';\nconst EXCLUDED_EMAIL = 'excluded@example.com';\nconst EXCLUDED_NAME = 'flo labs';\n\nconst MIN_BRIEF_SECONDS = 90 * 60; // 1.5 hours\nconst FULL_SESSION_TOLERANCE_SECONDS = 10 * 60; // 10 minutes tolerance\n\nconst john = items.find(p => {\n  const email = (p.email || '').trim().toLowerCase();\n  const name = (p.name || '').trim().toLowerCase();\n  return email === JOHN_EMAIL || name === 'john hazlewood';\n});\n\nif (!john) {\n  throw new Error('John Hazlewood was not found in participants list.');\n}\n\nconst johnDuration = Number(john.duration || 0);\n\nif (!johnDuration || johnDuration <= 0) {\n  throw new Error('John duration is missing or zero.');\n}\n\nconst results = [];\n\nfor (const p of items) {\n  const email = (p.email || '').trim().toLowerCase();\n  const name = (p.name || '').trim().toLowerCase();\n  const duration = Number(p.duration || 0);\n\n  if (\n    email === JOHN_EMAIL ||\n    email === OLIVER_EMAIL ||\n    email === EXCLUDED_EMAIL ||\n    name === EXCLUDED_NAME\n  ) {\n    continue;\n  }\n\n  let attendance_case = '';\n  let comments = '';\n  let email_template_key = '';\n\n  if (duration < MIN_BRIEF_SECONDS) {\n    attendance_case = 'briefly_attended';\n    comments = `attended only ${Math.round(duration / 60)} minutes; sent Briefly Attended;`;\n    email_template_key = 'briefly_attended';\n  } else if ((johnDuration - duration) <= FULL_SESSION_TOLERANCE_SECONDS) {\n    attendance_case = 'full_session';\n    comments = 'attended the whole session; sent Attended + Masterclass;';\n    email_template_key = 'attended_masterclass';\n  } else {\n    attendance_case = 'missed_qna';\n    comments = 'attended part of the session and missed the end/Q&A; sent Briefly Attended + Q&A;';\n    email_template_key = 'briefly_attended_qna';\n  }\n\n  results.push({\n    json: {\n      ...p,\n      john_duration: johnDuration,\n      duration_minutes: Math.round(duration / 60),\n      john_duration_minutes: Math.round(johnDuration / 60),\n      minutes_shorter_than_john: Math.round((johnDuration - duration) / 60),\n      attendance_case,\n      comments,\n      email_template_key\n    }\n  });\n}\n\nreturn results;"
      },
